{
  "$comment": "Normative test vectors for the attachments DSL parser (spec/dsl-grammar.md). Each vector: input string -> expected source + options. Ranges are two-element integer arrays; a conforming Python parser maps them to tuples. Every implementation must pass all vectors.",
  "version": 1,
  "vectors": [
    { "name": "no options", "input": "file.pdf", "source": "file.pdf", "options": {} },
    { "name": "single int", "input": "data.xlsx[rows: 100]", "source": "data.xlsx", "options": { "rows": 100 } },
    { "name": "single range", "input": "file.pdf[pages: 1-4]", "source": "file.pdf", "options": { "pages": [1, 4] } },
    { "name": "multiple options", "input": "data.xlsx[sheet: Sales, rows: 100]", "source": "data.xlsx", "options": { "sheet": "Sales", "rows": 100 } },
    { "name": "bool true", "input": "doc.pdf[images: true]", "source": "doc.pdf", "options": { "images": true } },
    { "name": "bool false", "input": "doc.pdf[images: false]", "source": "doc.pdf", "options": { "images": false } },
    { "name": "bool yes-no", "input": "doc.pdf[a: yes, b: no]", "source": "doc.pdf", "options": { "a": true, "b": false } },
    { "name": "bool on-off case-insensitive", "input": "doc.pdf[a: ON, b: Off]", "source": "doc.pdf", "options": { "a": true, "b": false } },
    { "name": "one is integer not bool", "input": "data.xlsx[rows: 1]", "source": "data.xlsx", "options": { "rows": 1 } },
    { "name": "zero is integer not bool", "input": "data.xlsx[rows: 0]", "source": "data.xlsx", "options": { "rows": 0 } },
    { "name": "negative int", "input": "f.txt[offset: -3]", "source": "f.txt", "options": { "offset": -3 } },
    { "name": "float", "input": "f.txt[scale: 1.5]", "source": "f.txt", "options": { "scale": 1.5 } },
    { "name": "bare string", "input": "data.xlsx[sheet: Revenue]", "source": "data.xlsx", "options": { "sheet": "Revenue" } },
    { "name": "quoted string with comma", "input": "f.csv[name: \"hello, world\", count: 5]", "source": "f.csv", "options": { "name": "hello, world", "count": 5 } },
    { "name": "quoted string stays string", "input": "f.csv[id: \"42\"]", "source": "f.csv", "options": { "id": "42" } },
    { "name": "single-quoted", "input": "f.csv[label: 'a b']", "source": "f.csv", "options": { "label": "a b" } },
    { "name": "value with colon", "input": "doc.pdf[password: a:b]", "source": "doc.pdf", "options": { "password": "a:b" } },
    { "name": "whitespace trimmed", "input": "doc.pdf[  pages :  1-4 , dpi:300 ]", "source": "doc.pdf", "options": { "pages": [1, 4], "dpi": 300 } },
    { "name": "key normalization dashes and case", "input": "data.xlsx[Max-Rows: 50]", "source": "data.xlsx", "options": { "max_rows": 50 } },
    { "name": "key normalization spaces", "input": "data.xlsx[max rows: 50]", "source": "data.xlsx", "options": { "max_rows": 50 } },
    { "name": "duplicate key last wins", "input": "doc.pdf[dpi: 100, dpi: 300]", "source": "doc.pdf", "options": { "dpi": 300 } },
    { "name": "empty options block stripped", "input": "doc.pdf[]", "source": "doc.pdf", "options": {} },
    { "name": "trailing comma tolerated", "input": "doc.pdf[dpi: 300,]", "source": "doc.pdf", "options": { "dpi": 300 } },
    { "name": "segment without colon means no options block", "input": "weird[1].bin", "source": "weird[1].bin", "options": {} },
    { "name": "final group without colon stays in source", "input": "archive[backup]", "source": "archive[backup]", "options": {} },
    { "name": "brackets in url untouched", "input": "https://example.com/a[1]/b.pdf[pages: 2-3]", "source": "https://example.com/a[1]/b.pdf", "options": { "pages": [2, 3] } },
    { "name": "url with query", "input": "https://example.com/f.pdf?x=1[dpi: 144]", "source": "https://example.com/f.pdf?x=1", "options": { "dpi": 144 } },
    { "name": "github source", "input": "github://org/repo[branch: main]", "source": "github://org/repo", "options": { "branch": "main" } },
    { "name": "page list stays string", "input": "doc.pdf[pages: \"1,3-5\"]", "source": "doc.pdf", "options": { "pages": "1,3-5" } },
    { "name": "leading-trailing input whitespace", "input": "  doc.pdf[dpi: 72]  ", "source": "doc.pdf", "options": { "dpi": 72 } },
    { "name": "range with spaces", "input": "doc.pdf[pages: 1 - 4]", "source": "doc.pdf", "options": { "pages": [1, 4] } },
    { "name": "not ending with bracket", "input": "doc[pages: 1].pdf", "source": "doc[pages: 1].pdf", "options": {} }
  ]
}
