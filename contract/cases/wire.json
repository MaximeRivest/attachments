{
 "area": "wire",
 "review": "draft",
 "cases": [
  {
   "name": "a round trip keeps everything",
   "call": "from_wire",
   "input": [
    {
     "text": "hi",
     "images": [
      {
       "name": "p.png",
       "mimetype": "image/png",
       "bytes_b64": "iVBORw0KGgoAAAANSUhEUgAAACgAAAAeCAYAAAAfFcSJ",
       "page": 1
      }
     ],
     "audio": [],
     "video": [],
     "meta": {
      "source": "a.pdf",
      "kind": "pdf",
      "extra": {
       "n": [
        1,
        {
         "x": null
        }
       ]
      }
     }
    }
   ],
   "expect": {
    "value": [
     {
      "text": "hi",
      "images": [
       {
        "name": "p.png",
        "mimetype": "image/png",
        "bytes_b64": "iVBORw0KGgoAAAANSUhEUgAAACgAAAAeCAYAAAAfFcSJ",
        "page": 1
       }
      ],
      "audio": [],
      "video": [],
      "meta": {
       "source": "a.pdf",
       "kind": "pdf",
       "extra": {
        "n": [
         1,
         {
          "x": null
         }
        ]
       }
      }
     }
    ]
   }
  },
  {
   "name": "missing keys are filled, source is not invented",
   "call": "from_wire",
   "input": [
    {
     "text": "x"
    },
    {}
   ],
   "expect": {
    "value": [
     {
      "text": "x",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {}
     },
     {
      "images": [],
      "text": "",
      "audio": [],
      "video": [],
      "meta": {}
     }
    ]
   }
  },
  {
