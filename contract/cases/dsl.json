   "expect": {
    "value": "x[t: \"true\", n: \"-3\", f: \"1.5\", r: \"2-3\", s: \" pad \", e: \"\"]",
    "reparsed": {
     "source": "x",
     "options": {
      "t": "true",
      "n": "-3",
      "f": "1.5",
      "r": "2-3",
      "s": " pad ",
      "e": ""
     }
    }
   }
  },
  {
   "name": "format x {'b': False, 'i': -7, 'z': 0, 'fl': 2.5}",
   "call": "format",
