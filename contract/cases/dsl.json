     "options": {
      "b": false,
      "i": -7,
      "z": 0,
      "fl": 2.5
     }
    }
   }
  },
  {
   "name": "format x {'br': 'a]b', 'bl': 'a[b', 'c': 'a:b'}",
   "call": "format",
   "source": "x",
   "options": {
