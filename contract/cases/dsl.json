{
 "area": "dsl",
 "review": "draft",
 "cases": [
  {
   "name": "format file.pdf {}",
   "call": "format",
   "source": "file.pdf",
   "options": {},
   "expect": {
    "value": "file.pdf",
    "reparsed": {
     "source": "file.pdf",
     "options": {}
    }
   }
  },
  {
   "name": "format file.pdf {'pages': [1, 4], 'images': True}",
   "call": "format",
   "source": "file.pdf",
   "options": {
    "pages": [
     1,
     4
    ],
    "images": true
   },
   "expect": {
    "value": "file.pdf[pages: 1-4, images: true]",
    "reparsed": {
     "source": "file.pdf",
     "options": {
      "pages": [
       1,
       4
      ],
      "images": true
     }
    }
   }
  },
  {
   "name": "format f.csv {'name': 'a, b', 'id': '42'}",
   "call": "format",
   "source": "f.csv",
   "options": {
    "name": "a, b",
    "id": "42"
   },
   "expect": {
    "value": "f.csv[name: \"a, b\", id: \"42\"]",
    "reparsed": {
     "source": "f.csv",
     "options": {
      "name": "a, b",
      "id": "42"
     }
    }
   }
  },
  {
   "name": "format f.csv {'q': 'say \"hi\"', 'w': \"it's\"}",
   "call": "format",
   "source": "f.csv",
   "options": {
    "q": "say \"hi\"",
    "w": "it's"
   },
   "expect": {
    "value": "f.csv[q: 'say \"hi\"', w: \"it's\"]",
    "reparsed": {
     "source": "f.csv",
     "options": {
      "q": "say \"hi\"",
      "w": "it's"
     }
    }
   }
  },
  {
