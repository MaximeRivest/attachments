{
 "area": "inputs",
 "review": "draft",
 "cases": [
  {
   "name": "named bytes",
   "input": {
    "name": "notes.md",
    "bytes_b64": "IyBOb3Rlcw=="
   },
   "expect": {
    "artifacts": [
     {
      "text": "# Notes",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {
       "kind": "text",
       "extra": {
        "encoding": "utf-8",
        "chars": 7,
        "filename": "notes.md"
       },
       "source": "notes.md"
      }
     }
    ]
   }
  },
  {
   "name": "named bytes are not parsed for options",
   "input": {
    "name": "notes.md[pages: 1]",
    "bytes_b64": "IyBOb3Rlcw=="
   },
   "expect": {
    "artifacts": [
     {
      "text": "# Notes",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {
       "kind": "text",
       "extra": {
        "encoding": "utf-8",
        "chars": 7,
        "filename": "notes.md[pages: 1]"
       },
       "source": "notes.md[pages: 1]"
      }
     }
    ]
   }
  },
  {
   "name": "unnamed bytes are called file",
   "input": {
    "name": null,
    "bytes_b64": "cGxhaW4gd29yZHM="
   },
   "expect": {
    "artifacts": [
     {
      "text": "plain words",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {
       "kind": "text",
       "extra": {
        "encoding": "utf-8",
        "chars": 11,
        "filename": "file"
       },
       "source": "file"
      }
     }
    ]
   }
  },
  {
   "name": "unnamed bytes found by their content",
   "input": {
    "name": null,
    "bytes_b64": ""
   },
   "expect": {
    "artifacts": [
     {
      "text": "",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {
       "source": "file",
       "note": "no local processor available"
      }
     }
    ]
   }
  },
  {
   "name": "bare bytes are refused",
   "input": {
    "bare_bytes_b64": "eA=="
   },
   "expect": {
    "artifacts": [
     {
      "text": "",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {
       "source": "<bytes>",
       "error": {
        "code": "unpack-error"
       }
      }
     }
    ]
   }
  },
  {
   "name": "a number is refused",
   "input": {
    "number": 42
   },
   "expect": {
    "artifacts": [
     {
      "text": "",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {
       "source": "42",
       "error": {
        "code": "unpack-error"
       }
      }
     }
    ]
   }
  },
  {
   "name": "a list mixes kinds",
   "input": [
    {
     "name": "a.txt",
     "bytes_b64": "YQ=="
    },
    {
     "number": 1
    },
    [
     {
      "name": "b.txt",
      "bytes_b64": "Yg=="
     }
    ]
   ],
   "expect": {
    "artifacts": [
     {
      "text": "a",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {
       "kind": "text",
       "extra": {
        "encoding": "utf-8",
        "chars": 1,
        "filename": "a.txt"
       },
       "source": "a.txt"
      }
     },
     {
      "text": "",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {
       "source": "1",
       "error": {
        "code": "unpack-error"
       }
      }
     },
     {
      "text": "b",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {
       "kind": "text",
       "extra": {
        "encoding": "utf-8",
        "chars": 1,
        "filename": "b.txt"
       },
       "source": "b.txt"
      }
     }
    ]
   }
  },
  {
   "name": "an empty list",
   "input": [],
   "expect": {
    "artifacts": []
   }
  },
  {
   "name": "options apply to named bytes",
   "input": {
    "name": "a.txt",
    "bytes_b64": "YQ=="
   },
   "options": {
    "pagez": 1
   },
   "expect": {
    "artifacts": [
     {
      "text": "a",
      "images": [],
      "audio": [],
      "video": [],
      "meta": {
       "kind": "text",
       "extra": {
        "encoding": "utf-8",
        "chars": 1,
        "filename": "a.txt"
       },
       "warnings": [
        "Unknown option 'pagez' for .txt"
       ],
       "source": "a.txt"
      }
     }
    ]
   }
  }
 ]
}
