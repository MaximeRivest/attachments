# api.attachments.dev — FREE tier configuration
# Copy to deploy/.env on the server, review every line, then:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d

# --- Auth -------------------------------------------------------------------
# EMPTY = keyless open free tier: anyone can POST. The tradeoff:
#   + zero-friction launch ("pip install attachments — it just works")
#   - abuse risk is carried entirely by nginx rate limiting (10 req/min/IP on
#     POSTs) + the 25 MB upload cap + CloudWatch billing alarm.
# Alternative — shared beta key mode: set a single key here, publish it in the
# docs/README ("beta key: ..."). Clients send it via configure(api_key=...).
# Trivial to rotate when abused; slightly more friction for users.
ATTACHMENTS_SERVER_KEY=

# --- Limits -----------------------------------------------------------------
# 25 MB. MUST stay aligned with client_max_body_size 25m in deploy/nginx.conf.
ATTACHMENTS_MAX_UPLOAD=26214400

# --- SSRF guard --------------------------------------------------------------
# The guard is ON by default (server blocks /unpack fetches to loopback,
# link-local/cloud-metadata, and private ranges). Leave this UNSET in
# production. Never set ATTACHMENTS_ALLOW_PRIVATE_URLS on a public server.
# ATTACHMENTS_ALLOW_PRIVATE_URLS=   # <- do not enable

# --- Tuning ------------------------------------------------------------------
# gunicorn workers: 2 for c7a.large (2 vCPU), 4 for c7a.xlarge (4 vCPU).
WEB_CONCURRENCY=2
# Container memory cap for the api service.
API_MEM_LIMIT=3g

# --- GPU phase 2 (separate g6.xlarge running vLLM + LightOnOCR) ---------------
# ATTACHMENTS_LIGHTON_URL=http://<gpu-private-ip>:8100/v1
