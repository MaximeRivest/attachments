#!/usr/bin/env bash
# The one command. Green here = every implementation keeps the contract.
#   1) the contract: contract/cases/ is exactly what contract/cases/make.py writes
#   2) Python: lint, then the tests (the contract's cases among them)
#   3) TypeScript: generated files, types, then the tests (the same cases)
set -euo pipefail
cd "$(dirname "$0")"
step() { printf '\n== %s ==\n' "$1"; }

step "1/3 the contract"
cases() { (cd contract/cases && find . -name '*.json' | sort | xargs sha256sum | sha256sum); }
before=$(cases)
uv run --frozen python contract/cases/make.py >/dev/null
if [ "$before" != "$(cases)" ]; then
  echo "contract/cases/ differ from what make.py writes: commit make.py's output, or fix make.py" >&2
  exit 1
fi
echo "cases match make.py"

step "2/3 python"
uv run --frozen ruff check . -q
uv run --frozen ruff format --check . -q
uv run --frozen pytest -p no:cacheprovider 2>&1 | grep -E "[0-9]+ (passed|failed)"

step "3/3 typescript"
if [ ! -f ts/node_modules/.package-lock.json ] || [ ts/package-lock.json -nt ts/node_modules/.package-lock.json ]; then
  (cd ts && npm ci --no-audit --no-fund)
fi
(cd ts && npx tsc --noEmit && node --conditions=attachments-source --test tests/*.test.ts 2>&1 | grep -E '^ℹ (tests|pass|fail)|^✖'; exit "${PIPESTATUS[0]}")
